; ── processes classmap ───────────────────────────────────────────────────────
;
; Semantic permission groups for process-to-process operations.
;
; Slots:
;   transform  - change a process label (exec transitions, setexec, etc.)
;   describe   - read process attributes without modifying them
;   relax      - weaken memory-protection constraints (execmem/execstack)
;   interact   - everything else: signals, scheduling, ptrace, fork, etc.

(classmap processes (transform describe relax interact))

; ── transform ─────────────────────────────────────────────────────────────────
; Label-changing operations: domain transitions and exec-context overrides.

(classmapping processes transform (
    process (
        dyntransition transition setcurrent setexec
        setfscreate setkeycreate setsockcreate)))
(classmapping processes transform (
    process2 (nnp_transition nosuid_transition)))
(classmapping processes transform (
    io_uring (override_creds)))

; ── describe ──────────────────────────────────────────────────────────────────
; Read-only introspection of process attributes.

(classmapping processes describe (
    process (
        getsched getsession getpgid getcap getattr getrlimit)))

; ── relax ─────────────────────────────────────────────────────────────────────
; Weaken memory-protection constraints. Should be denied for all host processes
; via neverallow; containers may need it.

(classmapping processes relax (
    process (execheap execmem execstack)))
(classmapping processes relax (
    memprotect (mmap_zero)))

; ── interact ──────────────────────────────────────────────────────────────────
; Everything else: fork, signals, scheduling, ptrace, io_uring ops.
; Defined via negation so new process permissions are automatically included.

(classmapping processes interact (
    process (not (
        dyntransition transition setcurrent setexec
        setfscreate setkeycreate setsockcreate
        getsched getsession getpgid getcap getattr getrlimit
        execheap execmem execstack))))
(classmapping processes interact (
    io_uring (sqpoll allowed)))
