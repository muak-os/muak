; ── kernel_t: devtmpfs access ────────────────────────────────────────────────
;
; Kernel threads (kdevtmpfs) create device nodes in devtmpfs after the policy
; is loaded, so kernel_t needs these grants. /init itself runs as granola_t
; after the relabel and needs none of them.

(allow kernel_t devtmpfs_t (dir      (read write search create add_name remove_name rmdir getattr)))
(allow kernel_t devtmpfs_t (blk_file (read write open getattr setattr ioctl create unlink)))
(allow kernel_t devtmpfs_t (chr_file (read write open getattr ioctl create setattr unlink)))

; Creating a device node also checks CAP_MKNOD, which the file and directors grants above do not cover.
(allow kernel_t self (capability (mknod)))
