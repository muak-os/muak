; ── Global attribute-level allow rules ────────────────────────────────────────
;
; Permissions that apply broadly across all domains or all objects. These
; replace repetitive per-domain grants and make the policy's trust model
; explicit in one place.

; All subjects can describe all objects (getattr on files, dirs, etc.).
(allow all_s global (files (describe)))

; All subjects can read anything in the system.
(allow all_s global (files (load)))

; All subjects can describe all other subjects' processes.
(allow all_s all_s (processes (describe)))

; All subjects except forbidden_t can use the label they already have.
; forbidden_t is excluded to satisfy the companion neverallow in neverallow.cil.
(allow transformable_s self (processes (transform)))

; All subjects can interact with their own processes.
(allow all_s self (processes (interact)))

; All subjects can write to files labeled with their own type (/proc/self).
(allow all_s self (files (mutate)))

; Privileged subjects can interact with all processes.
(allow privileged_s all_s (processes (interact)))

; Backstop against kernel execution of mutable objects: any exec by kernel_t
; from a mutable-labeled file transitions to forbidden_t, which is then blocked
; by the companion neverallow in neverallow.cil.
(typetransition kernel_t mutable_o process forbidden_t)

; All subjects can use all socket types without restriction.
(allow all_s global (sockets (use)))

; All subjects can use all network objects without restriction.
(allow all_s global (networks (use)))

; ── Baseline grants for all service domains ───────────────────────────────────

; Services write stdout/stderr to granola's pipe or directly to /dev.
(allow service_t devtmpfs_t  (chr_file (write append)))
(allow service_t unlabeled_t (chr_file (write append)))
(allow service_t kernel_t    (chr_file (write append)))
(allow service_t granola_t   (fifo_file (write)))

; Services read /proc (for /proc/self and process introspection).
(call allow_proc_read (service_t))

; Services can read /run sockets and files (inter-service coordination).
(allow service_t muak_run_t (dir       (read search)))
(allow service_t muak_run_t (file      (read open getattr)))
(allow service_t muak_run_t (sock_file (read write getattr)))
