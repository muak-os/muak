; Read /proc: self dir/file stat for /proc/self entries.
; load/describe on proc_t are covered globally; this adds the self-process
; dir search and file open/read that /proc/self requires.
(macro allow_proc_read ((type domain))
    (allow domain proc_t (files (load)))
    (allow domain proc_t (files (describe)))
    (allow domain domain (dir  (search)))
    (allow domain domain (file (open read getattr))))

; Read /sys: dir search + file read + symlink follow.
(macro allow_sysfs_read ((type domain))
    (allow domain sysfs_t (files (load)))
    (allow domain sysfs_t (files (describe))))

; Read and write /sys knobs.
(macro allow_sysfs_rw ((type domain))
    (allow domain sysfs_t (dir      (read open search getattr)))
    (allow domain sysfs_t (file     (read write open getattr)))
    (allow domain sysfs_t (lnk_file (read))))

; Read /dev: dir search + chr_file read/write.
(macro allow_devtmpfs_read ((type domain))
    (allow domain devtmpfs_t (dir      (read search)))
    (allow domain devtmpfs_t (chr_file (read write open getattr))))

; Connect to a muak_run_t socket owned by another service.
(macro allow_run_socket_rw ((type domain))
    (allow domain muak_run_t (dir      (read search)))
    (allow domain muak_run_t (file     (read open getattr)))
    (allow domain muak_run_t (sock_file (read write getattr))))

; Full ownership of muak_run_t (PID files, sockets, dirs under /run).
(macro allow_run_rw ((type domain))
    (allow domain muak_run_t (files (load)))
    (allow domain muak_run_t (files (describe)))
    (allow domain muak_run_t (files (mutate)))
    (allow domain muak_run_t (files (mount))))

; Read-only access to muak_state_t + unlabeled_t fallback.
(macro allow_state_read ((type domain))
    (allow domain muak_state_t (files (load)))
    (allow domain muak_state_t (files (describe)))
    (allow domain unlabeled_t  (files (load)))
    (allow domain unlabeled_t  (files (describe))))

; Read/write access to muak_state_t + unlabeled_t fallback.
(macro allow_state_rw ((type domain))
    (allow domain muak_state_t (files (load)))
    (allow domain muak_state_t (files (describe)))
    (allow domain muak_state_t (files (mutate)))
    (allow domain unlabeled_t  (files (load)))
    (allow domain unlabeled_t  (files (describe)))
    (allow domain unlabeled_t  (files (mutate))))

; Read/write access to muak_data_t.
(macro allow_data_rw ((type domain))
    (allow domain muak_data_t (files (load)))
    (allow domain muak_data_t (files (mutate))))

; Declare a confined service domain and wire it into the policy.
;
; Grants: role bindings, entrypoint perms, granola_t->svc_t typetransition,
; sqsh_file_type membership for the exec type (overlay mounter getattr),
; and the baseline permissions every service needs at runtime:
;   - /proc read, /run socket read/write, rootfs file read
;   - write to granola's fifo and /dev chr_file (stdout/stderr redirect)
;
; Global rules in rules.cil cover: process self-interaction and describe,
; self-transform, fd use, all file reads (load/describe), all socket use,
; all network object use.
;
; Usage: (call declare_service (svc_t svc_exec_t))
(macro declare_service ((type svc_t) (type svc_exec_t))
    (roletype system_r svc_t)
    (roletype object_r svc_exec_t)
    (typeattributeset service_t      (svc_t))
    (typeattributeset service_exec_t (svc_exec_t))
    (typeattributeset sqsh_file_type (svc_exec_t))
    ; MCS: service processes are host subjects; exec types are unconstrained objects.
    (typeattributeset all_s           (svc_t))
    (typeattributeset all_o           (svc_exec_t))
    (typeattributeset unconstrained_o (svc_exec_t))
    (allow svc_t     svc_exec_t  (files       (load)))
    (allow svc_t     svc_exec_t  (files       (execute)))
    (allow svc_t     svc_exec_t  (files       (enter)))
    (allow granola_t svc_exec_t  (files       (execute)))
    (allow kernel_t  svc_exec_t  (files       (execute)))
    (allow granola_t svc_t       (processes   (transform)))
    (allow granola_t svc_t       (process     (noatsecure rlimitinh siginh)))
    (allow svc_t     devtmpfs_t  (chr_file    (write)))
    (allow svc_t     unlabeled_t (chr_file    (write)))
    (allow svc_t     kernel_t    (chr_file    (write)))
    (allow svc_t     granola_t   (fifo_file   (write)))
    (allow svc_t     muak_run_t  (dir         (read search)))
    (allow svc_t     muak_run_t  (file        (read open getattr)))
    (allow svc_t     muak_run_t  (sock_file   (read write getattr)))
    (call allow_proc_read (svc_t))
    (typetransition granola_t svc_exec_t process svc_t))
