; Optional fleet inventory. Existing service grants are preserved.
(type fleet_t)
(roletype system_r fleet_t)
(typeattributeset service_t (fleet_t))
(typeattributeset verified_s (fleet_t))
(type fleetd_exec_t)
(call declare_exec (fleet_t fleetd_exec_t))
(filecon "/sbin/fleetd" file (system_u object_r fleetd_exec_t s0))

(type fleet_api_socket_t)
(type fleet_inventory_socket_t)
(type workload_api_socket_t)
(type fleet_state_t)
(roletype object_r fleet_api_socket_t)
(roletype object_r fleet_inventory_socket_t)
(roletype object_r workload_api_socket_t)
(roletype object_r fleet_state_t)
(typeattributeset all_o (fleet_api_socket_t fleet_inventory_socket_t workload_api_socket_t fleet_state_t))
(typeattributeset unconstrained_o (fleet_api_socket_t fleet_inventory_socket_t workload_api_socket_t fleet_state_t))
(typeattributeset mutable_o (fleet_api_socket_t fleet_inventory_socket_t workload_api_socket_t fleet_state_t))
(typeattributeset ephemeral_o (fleet_api_socket_t fleet_inventory_socket_t workload_api_socket_t fleet_state_t))
(allow fleet_api_socket_t tmpfs_t (filesystem (associate)))
(allow fleet_inventory_socket_t tmpfs_t (filesystem (associate)))
(allow workload_api_socket_t tmpfs_t (filesystem (associate)))
(allow fleet_state_t fs_t (filesystem (associate)))
(allow fleet_state_t tmpfs_t (filesystem (associate)))

; Named transitions override the supervisor's generic socket label.
(typetransition granola_t muak_run_t sock_file "fleetd.sock" fleet_api_socket_t)
(typetransition granola_t muak_run_t sock_file "workloadd.sock" workload_api_socket_t)
(typetransition fleet_t muak_run_t sock_file "fleetd.inventory.sock" fleet_inventory_socket_t)
(allow granola_t fleet_api_socket_t (files (mutate)))
(allow granola_t workload_api_socket_t (files (mutate)))
(allow api_t fleet_api_socket_t (sock_file (write)))
(allow fleet_t fleet_api_socket_t (sock_file (write)))
(allow fleet_t fleet_inventory_socket_t (files (mutate)))
(allow workloadd_t fleet_inventory_socket_t (sock_file (write)))

; Preserve access to workloadd for existing subjects; fleetd gets none.
(typeattribute non_fleet_s)
(typeattributeset non_fleet_s (and (all_s) (not (fleet_t))))
(allow non_fleet_s workload_api_socket_t (sock_file (write)))
(neverallow fleet_t workload_api_socket_t (sock_file (write)))
(neverallow workloadd_t fleet_api_socket_t (sock_file (write)))

; New fleet state cannot be modified through the shared STATE label.
(call allow_state_read (fleet_t))
(allow fleet_t muak_state_t (dir (write add_name)))
(allow fleet_t fs_t (dir (write add_name)))
(typetransition fleet_t muak_state_t dir "fleet" fleet_state_t)
(typetransition fleet_t fs_t dir "fleet" fleet_state_t)
(typetransition fleet_t fleet_state_t file fleet_state_t)
(allow fleet_t fleet_state_t (files (mutate)))
(neverallow workloadd_t fleet_state_t (files (mutate)))
(allow fleet_t muak_run_t (dir (write add_name remove_name)))
(allow fleet_t self (tcp_socket (create connect read write getattr setopt getopt shutdown)))
(allow fleet_t unlabeled_t (tcp_socket (name_connect)))
