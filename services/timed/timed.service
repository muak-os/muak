name       = "timed"
command    = "/sbin/timed"
depends_on = ["networkd"]

# clock_settime(CLOCK_REALTIME) needs sys_time.
[sandbox]
profile = "strict"
capabilities = ["sys_time"]
no_new_privs = true

[sandbox.limits]
nofile = 4096
nproc = 256

# pids_max only: a memory limit low enough to matter needs the boot test.
[sandbox.cgroup]
pids_max = 512
