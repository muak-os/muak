name       = "apid"
command    = "/sbin/apid --maintenance $MAINTENANCE"
depends_on = ["networkd"]

# apid binds host.port, which may be a privileged port.
[sandbox]
profile = "strict"
capabilities = ["net_bind_service"]
no_new_privs = true

[sandbox.limits]
nofile = 4096
nproc = 256

# pids_max only: a memory limit low enough to matter needs the boot test.
[sandbox.cgroup]
pids_max = 512
