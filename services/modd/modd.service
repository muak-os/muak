name       = "modd"
command    = "/sbin/modd"
depends_on = []

# all is the conservative default; narrowing per service needs a boot test.
[sandbox]
profile = "strict"
capabilities = "all"
no_new_privs = true

[sandbox.limits]
nofile = 4096
nproc = 256

# pids_max only: a memory limit low enough to matter needs the boot test.
[sandbox.cgroup]
pids_max = 512
