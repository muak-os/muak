name       = "modd"
command    = "/sbin/modd"
depends_on = []

# Module loading goes through init_module/finit_module.
[sandbox]
profile = "strict"
capabilities = ["sys_module"]
no_new_privs = true

[sandbox.limits]
nofile = 4096
nproc = 256

# pids_max only: a memory limit low enough to matter needs the boot test.
[sandbox.cgroup]
pids_max = 512
