name       = "networkd"
command    = "/sbin/networkd"
depends_on = []

# rtnetlink link/address/route changes need net_admin; DHCP and SLAAC sockets are raw.
[sandbox]
profile = "strict"
capabilities = ["net_admin", "net_raw"]
no_new_privs = true

[sandbox.limits]
nofile = 4096
nproc = 256

# pids_max only: a memory limit low enough to matter needs the boot test.
[sandbox.cgroup]
pids_max = 512
