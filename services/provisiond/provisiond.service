name       = "provisiond"
command    = "/sbin/provisiond"
depends_on = []

# mount/unmount and BLKRRPART need sys_admin, reboot/kexec need sys_boot, the
# device-mapper node needs mknod, and efivarfs needs linux_immutable to write.
[sandbox]
profile = "strict"
capabilities = ["sys_admin", "sys_boot", "mknod", "linux_immutable"]
no_new_privs = true

[sandbox.limits]
nofile = 4096
nproc = 256

# pids_max only: a memory limit low enough to matter needs the boot test.
[sandbox.cgroup]
pids_max = 512
