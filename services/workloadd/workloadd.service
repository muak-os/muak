name       = "workloadd"
command    = "/sbin/workloadd"
depends_on = ["networkd"]

# TAP creation and bridge attachment need net_admin; btrfs scrub needs sys_admin.
[sandbox]
profile = "strict"
capabilities = ["net_admin", "sys_admin"]
no_new_privs = true

[sandbox.limits]
nofile = 4096
nproc = 256

# pids_max only: a memory limit low enough to matter needs the boot test.
[sandbox.cgroup]
pids_max = 512
