name       = "consoled"
command    = "/sbin/consoled"
depends_on = []

# /dev/tty0 is a virtual console and /dev/kmsg is read through the syslog check.
[sandbox]
profile = "strict"
capabilities = ["sys_tty_config", "syslog"]
no_new_privs = true

[sandbox.limits]
nofile = 4096
nproc = 256

# pids_max only: a memory limit low enough to matter needs the boot test.
[sandbox.cgroup]
pids_max = 512
