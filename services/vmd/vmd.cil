; Muak SELinux policy: vmd (VM hypervisor manager)
; Domain: vmd_t

(type vmd_exec_t)
(call declare_exec (vmd_t vmd_exec_t))

(allow vmd_t self (capability (sys_admin net_admin)))

(allow vmd_t self (tun_socket (create)))

; networkd creates the TAP fd and passes it to cloud-hypervisor over the IPC
; socket. The kernel requires relabelfrom on the fd's current label (network_t)
; and relabelto on the destination label (vmd_t) to transfer socket ownership.
(allow vmd_t network_t (tun_socket (relabelfrom)))
(allow vmd_t self      (tun_socket (relabelto)))

(allow vmd_t network_t (unix_stream_socket (connectto)))

(allow vmd_t file_t      (file (execute execute_no_trans map)))
(allow vmd_t unlabeled_t (file (read open getattr execute execute_no_trans map)))

(call allow_sysfs_read    (vmd_t))
(call allow_devtmpfs_read (vmd_t))
(allow vmd_t devtmpfs_t (chr_file (ioctl)))

(call allow_run_rw   (vmd_t))

(allow vmd_t tmpfs_t (dir (write add_name remove_name)))
(typetransition vmd_t tmpfs_t dir muak_run_t)

(allow vmd_t fs_t (dir  (read write search create add_name remove_name)))
(allow vmd_t fs_t (file (read write create open getattr unlink rename)))

(call allow_state_rw (vmd_t))
(call allow_data_rw  (vmd_t))
