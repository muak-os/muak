; Muak SELinux policy: granola (PID 1 supervisor)

; Declare the granola process domain and its executable file type.
(type granola_t)
(type granola_exec_t)

; granola_t runs as a process (system_r); its binary is a passive object (object_r).
(roletype system_r granola_t)
(roletype object_r granola_exec_t)

; granola_exec_t lives on the squashfs rootfs (needs kernel_t getattr for overlay).
(typeattributeset sqsh_file_type (granola_exec_t))

; Allow kernel_t to transition into granola_t when executing granola_exec_t.
; "share" is needed because init execs in-place (no fork), retaining open FDs.
; "noatsecure" clears AT_SECURE so the new domain inherits the environment.
; "siginh" and "rlimitinh" allow signal dispositions and resource limits to
; carry over from kernel_t into granola_t across the execve boundary.
(allow kernel_t granola_t      (process (transition share noatsecure siginh rlimitinh)))
(allow kernel_t granola_exec_t (file (read execute getattr open map)))

; Automatically transition: when kernel_t execs a granola_exec_t file, the new
; process runs in the granola_t domain.
(typetransition kernel_t granola_exec_t process granola_t)

; Allow granola_t to use file descriptors inherited from kernel_t across the
; domain transition (e.g. /dev/console opened during early boot).
(allow granola_t kernel_t (fd (use)))

; Allow granola_t to read/write the SELinux null device (/sys/fs/selinux/null).
; The kernel redirects stdio FDs to this node during domain transitions; it is
; labeled unlabeled_t because selinuxfs creates it outside normal VFS labeling.
(allow granola_t unlabeled_t (chr_file (read write open getattr)))

; Allow granola_t to read/write character devices inherited from kernel_t
; (e.g. /dev/console on rootfs, which predates the devtmpfs mount).
(allow granola_t kernel_t (chr_file (read write open getattr)))

; Allow granola to fork child processes and send/receive lifecycle signals
; (SIGCHLD from children, SIGKILL/SIGSTOP for process management).
; getsched is needed by the Rust runtime to read scheduling parameters.
(allow granola_t self (process (fork sigchld sigkill sigstop signull signal getsched)))

; Grant granola the capabilities it needs: sys_admin for mount/namespace ops,
; setuid/setgid to drop privileges when spawning services, kill to signal
; managed services, chown to fix file ownership, dac_override to bypass
; file permission checks during setup.
(allow granola_t self (capability (sys_admin setuid setgid kill chown dac_override)))

; Grant granola CAP_SYSLOG for reading /dev/kmsg to capture kernel log output.
(allow granola_t self (capability2 (syslog)))

; Allow granola to read the kernel syslog ring buffer and write log messages.
; The target of syslog_read/syslog_mod is kernel_t (the system object), not
; self, because the kernel checks access against the kernel's own context.
(allow granola_t kernel_t (system (syslog_read syslog_mod)))

; Allow granola to read and write anonymous pipes (for capturing child process
; stdout/stderr via Stdio::piped()).
(allow granola_t self (fifo_file (read write open getattr)))

; Allow granola to create, bind, listen on, and use Unix stream sockets (for
; bidirectional IPC with supervised services).
(allow granola_t self (unix_stream_socket (create bind listen accept read write shutdown)))

; Allow granola to create and use Unix datagram sockets (for fire-and-forget
; notifications from services).
(allow granola_t self (unix_dgram_socket  (create bind read write)))

; Allow granola to read and execute its own binary (entrypoint verification).
(allow granola_t granola_exec_t (file (read execute entrypoint getattr open map)))

; Allow granola to read /proc (inspect child processes, read kernel tunables).
(call allow_proc_read (granola_t))

; Allow granola to read /sys (hardware info, driver attributes).
(allow granola_t sysfs_t    (dir  (read search)))
(allow granola_t sysfs_t    (file (read open getattr)))

; Allow granola to read /dev (access device nodes like /dev/null, /dev/console)
; and read/write character devices (for /dev/kmsg log output).
(allow granola_t devtmpfs_t (dir      (read search)))
(allow granola_t devtmpfs_t (chr_file (read write open getattr)))

; Allow granola to manage tmpfs (create/remove directories, files, and socket
; nodes for service communication).
(allow granola_t tmpfs_t    (dir       (read write search create add_name remove_name)))
(allow granola_t tmpfs_t    (file      (read write create open getattr unlink)))
(allow granola_t tmpfs_t    (sock_file (create unlink getattr)))

; When granola creates a socket on tmpfs, label it muak_run_t so services
; can access it via their muak_run_t permissions (e.g. granola-notify.sock).
(typetransition granola_t tmpfs_t sock_file muak_run_t)

; When granola creates a directory on tmpfs, label it muak_run_t so the
; /run/services directory and its contents get proper service labels.
(typetransition granola_t tmpfs_t dir muak_run_t)

; When granola creates objects inside muak_run_t directories (e.g. sockets
; inside /run/services/ which is already muak_run_t), keep the muak_run_t label.
(typetransition granola_t muak_run_t sock_file muak_run_t)
(typetransition granola_t muak_run_t file muak_run_t)

; Allow granola full read/write/create access to /run (PID files, sockets).
(call allow_run_rw (granola_t))

; Allow granola to read service state from /run/state (config snapshots).
(call allow_state_read (granola_t))

; Allow granola to traverse and read the rootfs (overlay/squashfs). file_t is
; the catch-all type for most rootfs inodes; unlabeled_t covers the overlay
; root inode which has no xattr.
(allow granola_t file_t      (dir      (read search open getattr)))
(allow granola_t file_t      (file     (read open getattr execute execute_no_trans map)))
(allow granola_t file_t      (lnk_file (read)))
(allow granola_t unlabeled_t (dir      (read search open getattr)))
