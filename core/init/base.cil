; Muak SELinux base policy (CIL)
;
; Global skeleton: MLS config, initial SIDs, object classes, roles, user,
; shared kernel/system types, pseudo-filesystem types, filesystem labeling,
; and global file contexts. Per-service types live in each service's own CIL
; file alongside its source. Macros live in macros.cil.

; ── Policy configuration ─────────────────────────────────────────────────────

; Deny access when the policy has no explicit rule for a given permission.
(handleunknown deny)

; Disable Multi-Level Security (categories/sensitivities); we use type
; enforcement only, but MLS boilerplate is still required by CIL.
(mls false)

; ── MLS boilerplate (required even with mls false) ───────────────────────────

; Define a single sensitivity level "s0" and a trivial ordering/level so the
; kernel's MLS validation passes even though MLS is not enforced.
(sensitivity s0)
(sensitivityorder (s0))
(level s0 (s0))

; ── Common permission sets (mirrors kernel classmap.h macros) ─────────────────

; Base permissions shared between file-like and socket-like objects.
(common file_sock_perms
    (ioctl read write create getattr setattr lock relabelfrom relabelto
     append map))

; Full permission set for regular files (extends file_sock_perms with
; unlink, link, rename, execute, mount, audit, watch, etc.).
(common file_perms
    (ioctl read write create getattr setattr lock relabelfrom relabelto
     append map unlink link rename execute quotaon mounton audit_access
     open execmod watch watch_mount watch_sb watch_with_perm watch_reads
     watch_mountns))

; Full permission set for sockets (extends file_sock_perms with bind,
; connect, listen, accept, and name resolution operations).
(common sock_perms
    (ioctl read write create getattr setattr lock relabelfrom relabelto
     append map bind connect listen accept getopt setopt shutdown
     recvfrom sendto name_bind))

; System V IPC permission set (semaphores, message queues, shared memory).
(common ipc_perms
    (create destroy getattr setattr read write associate unix_read
     unix_write))

; Linux capability bits (first set, capabilities 0-35).
(common cap_perms
    (chown dac_override dac_read_search fowner fsetid kill setgid setuid
     setpcap linux_immutable net_bind_service net_broadcast net_admin
     net_raw ipc_lock ipc_owner sys_module sys_rawio sys_chroot
     sys_ptrace sys_pacct sys_admin sys_boot sys_nice sys_resource
     sys_time sys_tty_config mknod lease audit_write audit_control
     setfcap))

; Linux capability bits (second set, capabilities 36+).
(common cap2_perms
    (mac_override mac_admin syslog wake_alarm block_suspend audit_read
     perfmon bpf checkpoint_restore))

; ── Object classes ────────────────────────────────────────────────────────────

; SELinux security server operations (load policy, set booleans, etc.).
(class security
    (compute_av compute_create compute_member check_context load_policy
     compute_relabel compute_user setenforce setbool setsecparam
     setcheckreqprot read_policy validate_trans))

; Process lifecycle and signal operations.
(class process
    (fork transition sigchld sigkill sigstop signull signal ptrace
     getsched setsched getsession getpgid setpgid getcap setcap share
     getattr setexec setfscreate noatsecure siginh setrlimit rlimitinh
     dyntransition setcurrent execmem execstack execheap setkeycreate
     setsockcreate getrlimit))

; Extended process permissions (no-new-privileges and nosuid transitions).
(class process2 (nnp_transition nosuid_transition))

; Kernel system operations (module loading, firmware, syslog, etc.).
(class system
    (ipc_info syslog_read syslog_mod syslog_console module_request
     module_load firmware_load kexec_image_load kexec_initramfs_load
     policy_load x509_certificate_load))

; POSIX capabilities (first set) -- inherits cap_perms.
(classcommon capability cap_perms)
(class capability ())

; Filesystem-level operations (mount, unmount, quota, watch).
(classcommon filesystem file_sock_perms)
(class filesystem
    (mount remount unmount associate quotamod quotaget watch))

; Regular file operations -- inherits file_perms, adds entrypoint (domain
; transition) and execute_no_trans (execute without transition).
(classcommon file file_perms)
(class file (execute_no_trans entrypoint))

; Directory operations -- inherits file_perms, adds add/remove name, search.
(classcommon dir file_perms)
(class dir (add_name remove_name reparent search rmdir))

; File descriptor passing between processes.
(class fd (use))

; Symbolic link operations.
(classcommon lnk_file file_perms)
(class lnk_file ())

; Character device operations (e.g. /dev/tty, /dev/null).
(classcommon chr_file file_perms)
(class chr_file (entrypoint))

; Block device operations (e.g. /dev/sda).
(classcommon blk_file file_perms)
(class blk_file (entrypoint))

; Unix domain socket file operations (the on-disk node, not the socket itself).
(classcommon sock_file file_perms)
(class sock_file ())

; Named pipe (FIFO) operations.
(classcommon fifo_file file_perms)
(class fifo_file ())

; Generic socket operations (fallback for address families without a
; dedicated class).
(classcommon socket sock_perms)
(class socket ())

; TCP socket operations -- adds node_bind and name_connect for binding to an
; address and initiating outgoing connections.
(classcommon tcp_socket sock_perms)
(class tcp_socket (node_bind name_connect))

; UDP socket operations -- adds node_bind for binding to an address.
(classcommon udp_socket sock_perms)
(class udp_socket (node_bind))

; Raw IP socket operations -- adds node_bind for binding to an address.
(classcommon rawip_socket sock_perms)
(class rawip_socket (node_bind))

; Network node (IP address) controls for sending and receiving.
(class node (recvfrom sendto))

; Network interface controls for packet ingress/egress.
(class netif (ingress egress))

; Generic netlink socket.
(classcommon netlink_socket sock_perms)
(class netlink_socket ())

; Packet socket (AF_PACKET) for raw link-layer frames.
(classcommon packet_socket sock_perms)
(class packet_socket ())

; Kernel key management socket.
(classcommon key_socket sock_perms)
(class key_socket ())

; Unix stream socket -- adds connectto for client connection initiation.
(classcommon unix_stream_socket sock_perms)
(class unix_stream_socket (connectto))

; Unix datagram socket.
(classcommon unix_dgram_socket sock_perms)
(class unix_dgram_socket ())

; System V semaphore.
(classcommon sem ipc_perms)
(class sem ())

; System V message.
(class msg (send receive))

; System V message queue -- adds enqueue.
(classcommon msgq ipc_perms)
(class msgq (enqueue))

; System V shared memory -- adds lock.
(classcommon shm ipc_perms)
(class shm (lock))

; Generic System V IPC.
(classcommon ipc ipc_perms)
(class ipc ())

; Netlink route socket -- for reading/writing routing table entries.
(classcommon netlink_route_socket sock_perms)
(class netlink_route_socket (nlmsg_read nlmsg_write nlmsg))

; Netlink TCP diagnostics socket -- for connection introspection.
(classcommon netlink_tcpdiag_socket sock_perms)
(class netlink_tcpdiag_socket (nlmsg_read nlmsg_write nlmsg))

; Netlink netfilter log socket.
(classcommon netlink_nflog_socket sock_perms)
(class netlink_nflog_socket ())

; Netlink XFRM (IPsec) socket.
(classcommon netlink_xfrm_socket sock_perms)
(class netlink_xfrm_socket (nlmsg_read nlmsg_write nlmsg))

; Netlink SELinux notification socket.
(classcommon netlink_selinux_socket sock_perms)
(class netlink_selinux_socket ())

; Netlink iSCSI socket.
(classcommon netlink_iscsi_socket sock_perms)
(class netlink_iscsi_socket ())

; Netlink audit socket -- for reading/writing audit messages.
(classcommon netlink_audit_socket sock_perms)
(class netlink_audit_socket
    (nlmsg_read nlmsg_write nlmsg_relay nlmsg_readpriv nlmsg_tty_audit
     nlmsg))

; Netlink FIB lookup socket.
(classcommon netlink_fib_lookup_socket sock_perms)
(class netlink_fib_lookup_socket ())

; Netlink connector socket.
(classcommon netlink_connector_socket sock_perms)
(class netlink_connector_socket ())

; Netlink netfilter socket.
(classcommon netlink_netfilter_socket sock_perms)
(class netlink_netfilter_socket ())

; Netlink DECnet routing socket.
(classcommon netlink_dnrt_socket sock_perms)
(class netlink_dnrt_socket ())

; IPsec security association.
(class association (sendto recvfrom setcontext polmatch))

; Netlink uevent socket -- receives kernel device hotplug events.
(classcommon netlink_kobject_uevent_socket sock_perms)
(class netlink_kobject_uevent_socket ())

; Generic netlink socket (genetlink family multiplexing).
(classcommon netlink_generic_socket sock_perms)
(class netlink_generic_socket ())

; Netlink SCSI transport socket.
(classcommon netlink_scsitransport_socket sock_perms)
(class netlink_scsitransport_socket ())

; Netlink RDMA socket.
(classcommon netlink_rdma_socket sock_perms)
(class netlink_rdma_socket ())

; Netlink crypto API socket.
(classcommon netlink_crypto_socket sock_perms)
(class netlink_crypto_socket ())

; AppleTalk socket (legacy).
(classcommon appletalk_socket sock_perms)
(class appletalk_socket ())

; Network packet (labeled networking).
(class packet (send recv relabelto forward_in forward_out))

; Kernel keyring key operations.
(class key (view read write search link setattr create))

; Memory protection (mmap of address zero).
(class memprotect (mmap_zero))

; Labeled networking peer.
(class peer (recv))

; POSIX capabilities (second set) -- inherits cap2_perms.
(classcommon capability2 cap2_perms)
(class capability2 ())

; Kernel service delegation (e.g. NFS using another process's credentials).
(class kernel_service (use_as_override create_files_as))

; TUN/TAP virtual network device socket -- adds attach_queue.
(classcommon tun_socket sock_perms)
(class tun_socket (attach_queue))

; Android Binder IPC (not used by Muak, but required by the kernel class list).
(class binder (impersonate call set_context_mgr transfer))

; User-namespace capabilities (first set).
(classcommon cap_userns cap_perms)
(class cap_userns ())

; User-namespace capabilities (second set).
(classcommon cap2_userns cap2_perms)
(class cap2_userns ())

; SCTP socket -- adds association management.
(classcommon sctp_socket sock_perms)
(class sctp_socket (node_bind name_connect association))

; ICMP socket (for ping).
(classcommon icmp_socket sock_perms)
(class icmp_socket (node_bind))

; AX.25 amateur radio socket.
(classcommon ax25_socket sock_perms)
(class ax25_socket ())

; IPX socket (legacy Novell networking).
(classcommon ipx_socket sock_perms)
(class ipx_socket ())

; NET/ROM amateur radio socket.
(classcommon netrom_socket sock_perms)
(class netrom_socket ())

; ATM PVC socket.
(classcommon atmpvc_socket sock_perms)
(class atmpvc_socket ())

; X.25 socket.
(classcommon x25_socket sock_perms)
(class x25_socket ())

; ROSE amateur radio socket.
(classcommon rose_socket sock_perms)
(class rose_socket ())

; DECnet socket.
(classcommon decnet_socket sock_perms)
(class decnet_socket ())

; ATM SVC socket.
(classcommon atmsvc_socket sock_perms)
(class atmsvc_socket ())

; RDS (Reliable Datagram Sockets) socket.
(classcommon rds_socket sock_perms)
(class rds_socket ())

; IrDA infrared socket.
(classcommon irda_socket sock_perms)
(class irda_socket ())

; PPPoE socket.
(classcommon pppox_socket sock_perms)
(class pppox_socket ())

; LLC (Logical Link Control) socket.
(classcommon llc_socket sock_perms)
(class llc_socket ())

; CAN bus socket.
(classcommon can_socket sock_perms)
(class can_socket ())

; TIPC (cluster communication) socket.
(classcommon tipc_socket sock_perms)
(class tipc_socket ())

; Bluetooth socket.
(classcommon bluetooth_socket sock_perms)
(class bluetooth_socket ())

; z/VM IUCV socket (IBM mainframe).
(classcommon iucv_socket sock_perms)
(class iucv_socket ())

; RxRPC socket (AFS transport).
(classcommon rxrpc_socket sock_perms)
(class rxrpc_socket ())

; ISDN socket.
(classcommon isdn_socket sock_perms)
(class isdn_socket ())

; Phonet socket (Nokia ISI protocol).
(classcommon phonet_socket sock_perms)
(class phonet_socket ())

; IEEE 802.15.4 (Zigbee/WPAN) socket.
(classcommon ieee802154_socket sock_perms)
(class ieee802154_socket ())

; CAIF (ST-Ericsson modem) socket.
(classcommon caif_socket sock_perms)
(class caif_socket ())

; Kernel crypto API socket (AF_ALG).
(classcommon alg_socket sock_perms)
(class alg_socket ())

; NFC socket.
(classcommon nfc_socket sock_perms)
(class nfc_socket ())

; Virtio/VM socket (host <-> guest communication).
(classcommon vsock_socket sock_perms)
(class vsock_socket ())

; KCM (Kernel Connection Multiplexor) socket.
(classcommon kcm_socket sock_perms)
(class kcm_socket ())

; Qualcomm IPC Router socket.
(classcommon qipcrtr_socket sock_perms)
(class qipcrtr_socket ())

; SMC (Shared Memory Communications) socket.
(classcommon smc_socket sock_perms)
(class smc_socket ())

; InfiniBand partition key access.
(class infiniband_pkey (access))

; InfiniBand end-port subnet management.
(class infiniband_endport (manage_subnet))

; eBPF operations (map and program lifecycle).
(class bpf
    (map_create map_read map_write prog_load prog_run map_create_as
     prog_load_as))

; XDP (eXpress Data Path) socket.
(classcommon xdp_socket sock_perms)
(class xdp_socket ())

; MCTP (Management Component Transport Protocol) socket.
(classcommon mctp_socket sock_perms)
(class mctp_socket ())

; Perf events (performance counters and tracing).
(class perf_event (open cpu kernel tracepoint read write))

; Anonymous inode operations (e.g. eventfd, epoll, signalfd).
(classcommon anon_inode file_perms)
(class anon_inode (execute_no_trans entrypoint))

; io_uring async I/O operations.
(class io_uring (override_creds sqpoll cmd allowed))

; User namespace creation.
(class user_namespace (create))

; memfd file operations (in-memory file descriptors).
(classcommon memfd_file file_perms)
(class memfd_file (execute_no_trans entrypoint))

; Canonical ordering of all object classes (must match the kernel's numbering).
(classorder
    (security process process2 system capability filesystem file dir fd
     lnk_file chr_file blk_file sock_file fifo_file socket tcp_socket
     udp_socket rawip_socket node netif netlink_socket packet_socket
     key_socket unix_stream_socket unix_dgram_socket sem msg msgq shm
     ipc netlink_route_socket netlink_tcpdiag_socket netlink_nflog_socket
     netlink_xfrm_socket netlink_selinux_socket netlink_iscsi_socket
     netlink_audit_socket netlink_fib_lookup_socket
     netlink_connector_socket netlink_netfilter_socket netlink_dnrt_socket
     association netlink_kobject_uevent_socket netlink_generic_socket
     netlink_scsitransport_socket netlink_rdma_socket netlink_crypto_socket
     appletalk_socket packet key memprotect peer capability2
     kernel_service tun_socket binder cap_userns cap2_userns sctp_socket
     icmp_socket ax25_socket ipx_socket netrom_socket atmpvc_socket
     x25_socket rose_socket decnet_socket atmsvc_socket rds_socket
     irda_socket pppox_socket llc_socket can_socket tipc_socket
     bluetooth_socket iucv_socket rxrpc_socket isdn_socket phonet_socket
     ieee802154_socket caif_socket alg_socket nfc_socket vsock_socket
     kcm_socket qipcrtr_socket smc_socket infiniband_pkey
     infiniband_endport bpf xdp_socket mctp_socket perf_event anon_inode
     io_uring user_namespace memfd_file))

; ── Roles ────────────────────────────────────────────────────────────────────

; system_r: role for all running processes (active subjects).
(role system_r)

; object_r: role for all passive objects (files, sockets, devices, etc.).
(role object_r)

; ── User ─────────────────────────────────────────────────────────────────────

; Single SELinux user identity used for the entire system.
(user system_u)

; system_u may assume either the process role or the object role.
(userrole system_u system_r)
(userrole system_u object_r)

; system_u operates at sensitivity level s0 (the only level).
(userlevel system_u (s0))
(userrange system_u ((s0) (s0)))

; ── Initial SIDs ─────────────────────────────────────────────────────────────
;
; Initial Security Identifiers are built-in labels the kernel uses before the
; policy is loaded. They provide default contexts for kernel objects.

; SID for the kernel process itself (PID 0 and early-boot threads).
(sid kernel)

; SID for the security server (SELinux internal state).
(sid security)

; SID for objects that have no label or whose label is invalid.
(sid unlabeled)

; SID fallback for files on filesystems without xattr support.
(sid file)

; SID for network ports.
(sid port)

; SID for network interfaces.
(sid netif)

; SID for network messages (packets in transit).
(sid netmsg)

; SID for network nodes (IP addresses).
(sid node)

; SID for /dev/null.
(sid devnull)

; SID for sockets with no explicit label.
(sid any_socket)

; Canonical ordering of initial SIDs (must match kernel expectations).
(sidorder
    (kernel security unlabeled file port netif netmsg node devnull
     any_socket))

; ── Shared kernel / system types ─────────────────────────────────────────────

; Type for the kernel itself and early-boot processes before domain transitions.
(type kernel_t)

; Type for the SELinux security server pseudo-filesystem objects.
(type security_t)

; Type for objects with no valid label (fallback).
(type unlabeled_t)

; Type for generic filesystem objects (mount points, cgroup, etc.).
(type fs_t)

; Type for generic files (catch-all for unlabeled on-disk files).
(type file_t)

; Type for generic directories.
(type dir_t)

; Bind each type to its appropriate role.
(roletype system_r kernel_t)
(roletype object_r security_t)
(roletype object_r unlabeled_t)
(roletype object_r fs_t)
(roletype object_r file_t)
(roletype object_r dir_t)

; ── Runtime file types ───────────────────────────────────────────────────────

; Type for runtime files and sockets under /run (PID files, service sockets).
(type muak_run_t)

; Type for persistent service state under /run/state (config snapshots).
(type muak_state_t)

; Type for persistent data on the data partition.
(type muak_data_t)

(roletype object_r muak_run_t)
(roletype object_r muak_state_t)
(roletype object_r muak_data_t)

; ── Pseudo-filesystem types ──────────────────────────────────────────────────

; Type for /proc entries (process info, kernel tunables).
(type proc_t)

; Type for /sys entries (hardware and driver attributes).
(type sysfs_t)

; Type for /dev entries (device nodes managed by devtmpfs).
(type devtmpfs_t)

; Type for tmpfs mounts (in-memory filesystems like /tmp).
(type tmpfs_t)

; Type for the SELinux pseudo-filesystem (mounted at /sys/fs/selinux).
(type selinuxfs_t)

; Type for the EFI variable filesystem (mounted at /sys/firmware/efi/efivars).
(type efivarfs_t)

(roletype object_r proc_t)
(roletype object_r sysfs_t)
(roletype object_r devtmpfs_t)
(roletype object_r tmpfs_t)
(roletype object_r selinuxfs_t)
(roletype object_r efivarfs_t)

; ── Other shared file types ──────────────────────────────────────────────────

; Type for kernel modules under /lib/modules.
(type modules_t)

(roletype object_r modules_t)

; ── Squashfs rootfs attribute ────────────────────────────────────────────────
;
; Attribute grouping every type that has an xattr label on the squashfs rootfs.
; overlayfs calls vfs_getxattr() on lower-layer inodes during path lookup
; (to read trusted.overlay.redirect), which triggers an SELinux getattr check.
; kernel_t must be allowed getattr on all such types so overlay resolution
; succeeds during switchroot/chroot.
(typeattribute sqsh_file_type)
(typeattributeset sqsh_file_type (modules_t file_t))

; ── SID contexts ─────────────────────────────────────────────────────────────
;
; Map each initial SID to a full security context (user:role:type:level).

; Kernel SID runs as system_u in the system_r role with kernel_t type.
(sidcontext kernel     (system_u system_r kernel_t ((s0) (s0))))

; Security server objects are passive (object_r).
(sidcontext security   (system_u object_r security_t ((s0) (s0))))

; Unlabeled objects get the unlabeled_t fallback type.
(sidcontext unlabeled  (system_u object_r unlabeled_t ((s0) (s0))))

; Default file context for filesystems without xattr support.
(sidcontext file       (system_u object_r file_t ((s0) (s0))))

; Network objects default to unlabeled_t.
(sidcontext port       (system_u object_r unlabeled_t ((s0) (s0))))
(sidcontext netif      (system_u object_r unlabeled_t ((s0) (s0))))
(sidcontext netmsg     (system_u object_r unlabeled_t ((s0) (s0))))
(sidcontext node       (system_u object_r unlabeled_t ((s0) (s0))))
(sidcontext devnull    (system_u object_r unlabeled_t ((s0) (s0))))
(sidcontext any_socket (system_u object_r unlabeled_t ((s0) (s0))))

; ── Filesystem labeling ──────────────────────────────────────────────────────
;
; squashfs and overlayfs support xattr-based labeling. Binary labels are
; embedded in the squashfs via mksquashfs pseudo-file definitions at build
; time. overlayfs delegates xattr reads to the underlying squashfs layers,
; so files get their per-inode labels. The fsuse default context (file_t)
; applies only to inodes that lack a security.selinux xattr.

; squashfs supports xattr-based labeling; files without xattrs get file_t.
(fsuse xattr squashfs (system_u object_r file_t ((s0) (s0))))

; overlayfs delegates xattr reads to lower layers; files without xattrs get
; file_t. Without this entry, genfscon would override xattr-based labeling.
(fsuse xattr overlay  (system_u object_r file_t ((s0) (s0))))

; ext4 and btrfs support xattr-based labeling; new files get fs_t by default.
(fsuse xattr ext4     (system_u object_r fs_t ((s0) (s0))))
(fsuse xattr btrfs    (system_u object_r fs_t ((s0) (s0))))

; pipefs and sockfs are kernel pseudo-filesystems for pipes and sockets;
; labeled per-task (the creating process's context is used).
(fsuse task  pipefs   (system_u object_r fs_t ((s0) (s0))))
(fsuse task  sockfs   (system_u object_r fs_t ((s0) (s0))))

; tmpfs and devtmpfs support transition-based labeling (context computed from
; the creating process's type + the filesystem type).
(fsuse trans tmpfs    (system_u object_r tmpfs_t ((s0) (s0))))
(fsuse trans devtmpfs (system_u object_r devtmpfs_t ((s0) (s0))))

; Label the root of each kernel pseudo-filesystem by path prefix.
(genfscon proc      / (system_u object_r proc_t      ((s0) (s0))))
(genfscon sysfs     / (system_u object_r sysfs_t     ((s0) (s0))))
(genfscon selinuxfs / (system_u object_r selinuxfs_t ((s0) (s0))))
(genfscon efivarfs  / (system_u object_r efivarfs_t  ((s0) (s0))))
(genfscon cgroup    / (system_u object_r fs_t        ((s0) (s0))))
(genfscon cgroup2   / (system_u object_r fs_t        ((s0) (s0))))

; ── init type and rules ───────────────────────────────────────────────────────
;
; /init runs from the initramfs (cpio/rootfs) before the SELinux policy is even
; loaded, so the process is always kernel_t throughout the entire pre-switchroot
; phase. There is no init_t domain transition: kernel_t holds all early-boot
; permissions directly.

; Allow kernel_t to fork, transition to service domains, send/receive signals,
; and inspect/modify its own scheduling and process group.
(allow kernel_t self (process (fork transition sigchld signull signal getsched setsched getattr getpgid setpgid getcap)))

; Grant kernel_t the capabilities needed during early boot: chroot into the
; real rootfs, perform privileged sysadmin operations, reboot, load kernel
; modules, create device nodes, and configure TTY devices.
(allow kernel_t self (capability (sys_chroot sys_admin sys_boot sys_module mknod dac_override sys_tty_config)))

; Grant kernel_t CAP_SYSLOG for reading /dev/kmsg.
(allow kernel_t self (capability2 (syslog)))

; Allow kernel_t to read the kernel syslog ring buffer (system:syslog_read is
; checked in addition to capability2:syslog when reading /dev/kmsg).
(allow kernel_t kernel_t (system (syslog_read)))

; Allow kernel_t to read and write anonymous pipes (used for capturing child
; process stdout/stderr when domain transitions do not fire).
(allow kernel_t self (fifo_file (read write open getattr)))

; Allow kernel_t to create and use Unix stream sockets (for granola IPC).
(allow kernel_t self (unix_stream_socket (create bind listen accept connect read write getattr shutdown)))

; Allow kernel_t to create and use Unix datagram sockets (for fire-and-forget
; notifications to services).
(allow kernel_t self (unix_dgram_socket  (create connect write sendto)))

; Allow kernel_t to use generic netlink sockets (for communicating with kernel
; subsystems like device event multicast groups).
(allow kernel_t self (netlink_generic_socket (create bind read write)))

; Allow kernel_t to read /proc (process info, kernel parameters).
(call allow_proc_read (kernel_t))

; Allow kernel_t to read, write, and create entries in /sys (driver attributes,
; power management, device configuration during early boot).
(allow kernel_t sysfs_t    (dir  (read write search create add_name)))
(allow kernel_t sysfs_t    (file (read write open getattr)))
(allow kernel_t sysfs_t    (lnk_file (read)))

; Allow kernel_t to manage /dev (create device nodes, read/write character and
; block devices during early boot before modd takes over).
(allow kernel_t devtmpfs_t (dir      (read write search create add_name remove_name)))
(allow kernel_t devtmpfs_t (blk_file (read write open getattr setattr ioctl create unlink)))
(allow kernel_t devtmpfs_t (chr_file (read write open getattr ioctl create setattr)))

; Allow device and file types to be stored on the devtmpfs filesystem.
(allow devtmpfs_t devtmpfs_t (filesystem (associate)))
(allow file_t     devtmpfs_t (filesystem (associate)))

; Allow unlabeled_t objects to exist on unlabeled_t filesystems (e.g. vfat/FAT32
; which has no xattr support; all inodes get unlabeled_t).
(allow unlabeled_t unlabeled_t (filesystem (associate)))

; Allow unlabeled_t objects to exist on fs_t filesystems (btrfs/ext4). When a
; process creates files on an xattr fs without a matching typetransition or
; xattr, the new inode may get unlabeled_t and needs to associate with fs_t.
(allow unlabeled_t fs_t (filesystem (associate)))

; Allow efivarfs_t objects to associate with efivarfs_t filesystem. Required
; when provisiond creates new EFI variable files during Secure Boot key enrollment.
(allow efivarfs_t efivarfs_t (filesystem (associate)))

; Allow kernel_t to manage tmpfs (create directories, files, and sockets for
; early service communication before the real /run is set up).
(allow kernel_t tmpfs_t    (dir       (read write search create add_name remove_name mounton)))
(allow kernel_t tmpfs_t    (file      (read write create open getattr unlink)))
(allow kernel_t tmpfs_t    (sock_file (create unlink getattr write)))

; Allow various types to be stored on tmpfs filesystems (needed because tmpfs
; uses transition-based labeling so new files may get a different type than
; the filesystem itself).
(allow tmpfs_t     tmpfs_t (filesystem (associate)))
(allow file_t      tmpfs_t (filesystem (associate)))
(allow muak_run_t  tmpfs_t (filesystem (associate)))
(allow muak_state_t tmpfs_t (filesystem (associate)))

; Allow kernel_t to interact with the SELinux pseudo-filesystem to load the
; compiled policy and toggle enforcement mode.
(allow kernel_t selinuxfs_t (dir  (search)))
(allow kernel_t selinuxfs_t (file (read write open getattr)))
(allow kernel_t security_t  (security (load_policy setenforce setbool)))

; Allow kernel_t to read EFI variables (boot entries, secure boot state).
(allow kernel_t efivarfs_t (dir  (read search)))
(allow kernel_t efivarfs_t (file (read open getattr)))

; Allow kernel_t to read kernel module files (for modprobe during early boot).
(allow kernel_t modules_t  (dir  (read search getattr)))
(allow kernel_t modules_t  (file (read open getattr)))

; Allow kernel_t to read, search, and execute files from the rootfs (file_t is
; the catch-all type for squashfs/overlay). mounton is needed to pivot_root.
(allow kernel_t file_t     (dir      (read search open getattr ioctl mounton)))
(allow kernel_t file_t     (file     (read open getattr execute execute_no_trans map)))
(allow kernel_t file_t     (lnk_file (read)))

; Allow kernel_t getattr on all xattr-labeled types on the squashfs rootfs.
; overlayfs calls vfs_getxattr() on lower-layer inodes during path lookup
; (to read trusted.overlay.redirect), which triggers an SELinux getattr check.
; The overlay mounter's credentials (kernel_t) are used for these checks.
(allow kernel_t sqsh_file_type (file     (getattr)))
(allow kernel_t sqsh_file_type (dir      (getattr)))
(allow kernel_t sqsh_file_type (lnk_file (getattr)))

; Allow kernel_t to traverse, mount on, and manage unlabeled directories. This
; covers overlay inodes without valid xattrs and btrfs root inodes on freshly
; formatted volumes. ioctl is needed for BTRFS_IOC_QUOTA_CTL on /run/data.
(allow kernel_t unlabeled_t (dir  (read write search getattr ioctl mounton)))
(allow kernel_t unlabeled_t (file (read open getattr)))

; Allow kernel_t to manage the /run directory tree (create PID files, service
; sockets, and runtime state before granola takes ownership).
(allow kernel_t muak_run_t   (dir  (read write search create add_name remove_name)))
(allow kernel_t muak_run_t   (file (read write create open getattr unlink)))
(allow kernel_t muak_state_t (dir  (read write search create add_name)))
(allow kernel_t muak_state_t (file (read write create open getattr)))
(allow kernel_t muak_data_t  (dir  (read write search create add_name)))
(allow kernel_t muak_data_t  (file (read write create open getattr)))

; Allow kernel_t to mount/unmount the state and data filesystems and perform
; filesystem-level operations on generic fs_t mounts (cgroup, etc.).
(allow kernel_t muak_state_t (filesystem (mount unmount)))
(allow kernel_t muak_data_t  (filesystem (mount unmount)))
(allow kernel_t fs_t         (filesystem (mount unmount getattr quotamod)))

; Allow kernel_t to read/write FIFOs (named pipes) on generic filesystems
; (used for early-boot process coordination).
(allow kernel_t fs_t         (fifo_file  (read write open getattr)))

; Allow kernel_t to send IPv6 multicast (MLD reports) on network interfaces.
; Kernel worker threads (kworker) send to ff02::16 during interface setup.
; Ports, nodes, and interfaces default to unlabeled_t.
(allow kernel_t unlabeled_t (association (sendto)))
(allow kernel_t unlabeled_t (node       (sendto)))
(allow kernel_t unlabeled_t (netif      (egress)))
