# Minimal KVM/QEMU optimized kernel config for x86_64
# Generated for Linux 6.x.x

# ==== Core System ====
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_GENERIC_BUILD_BUG_ON_ALIGN=y
CONFIG_HAVE_EBPF_JIT=y

# ==== PCI Support ====
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# ==== KVM/Virtualization ====
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y              # For Intel CPUs (or KVM_AMD for AMD)
CONFIG_KVM_AMD=y                # Enable both for flexibility
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y

# ==== VirtIO  ====
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_RING=y

# ==== Filesystems ====
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SQUASHFS=y               # For rootfs.sqsh
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y             # Used for extensions

# ==== Networking ====
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV4=y
CONFIG_IPV6=y
CONFIG_UNIX=y                   # Unix domain sockets
CONFIG_NETDEVICES=y
CONFIG_E1000=y                  # Fallback network driver
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# ==== Block Devices ====
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y           # Loop devices for containers
CONFIG_BLK_DEV_DM=y             # Device mapper
CONFIG_DM_CRYPT=y               # Encryption support

# ==== Security ====
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ==== Console & TTY ====
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y

# ==== Init System ====
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ==== EFI/UKI Support ====
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_EFI_VARS=y

# ==== Device Drivers (MINIMAL) ====
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ==== Disable unnecessary subsystems ====
CONFIG_USB=n
CONFIG_SOUND=n
CONFIG_VIDEO=n
CONFIG_DRM=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_EVDEV=n
CONFIG_ACPI_BUTTON=n
CONFIG_WATCHDOG=n
CONFIG_HID=n

# ==== Performance & Debugging ====
CONFIG_NO_HZ_FULL=y             # Full tickless kernel
CONFIG_PREEMPT_RT=n             # Not needed for hypervisor
CONFIG_DEBUG_INFO=n             # Reduces size

# ==== Modules (optional, disable for smaller kernel) ====
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
