# ==== Core System ====
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_GENERIC_BUILD_BUG_ON_ALIGN=y
CONFIG_HAVE_EBPF_JIT=y

# ==== PCI Support ====
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# ==== KVM/Virtualization ====
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y

# ==== VirtIO  ====
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_RING=y

# ==== Filesystems ====
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SQUASHFS=y               # For rootfs.sqsh
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y             # Used for extensions
CONFIG_BTRFS_FS=y               # btrfs for DATA partition (VM storage)
CONFIG_BTRFS_FS_POSIX_ACL=y     # POSIX ACLs for btrfs

# ==== Compression (for btrfs) ====
CONFIG_CRYPTO_ZSTD=y            # zstd compression for btrfs
CONFIG_ZLIB_DEFLATE=y           # zlib compression support
CONFIG_ZLIB_INFLATE=y           # zlib decompression support
CONFIG_LZO_COMPRESS=y           # LZO compression (optional)
CONFIG_LZO_DECOMPRESS=y         # LZO decompression (optional)

# ==== Namespaces (REQUIRED for rtnetlink) ====
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y                # Required by some namespace features

# ==== Networking ====
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV4=y
CONFIG_IPV6=y
CONFIG_UNIX=y                   # Unix domain sockets
CONFIG_NET_CORE=y
CONFIG_NETDEVICES=y
CONFIG_E1000=y                  # Fallback network driver
CONFIG_NETLINK_DIAG=y           # Netlink diagnostics for rtnetlink

# Bridge Support (force built-in, not modules)
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_LLC=y                    # Logical Link Control (required by bridge)
CONFIG_STP=y                    # Spanning Tree Protocol

# VLAN Support (force built-in)
CONFIG_VLAN_8021Q=y             # 802.1Q VLAN support

# TAP/TUN Support
CONFIG_TUN=y
CONFIG_VHOST_NET=y
CONFIG_VHOST=y

# Netfilter Core
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_PROCFS=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y
CONFIG_NF_CT_PROTO_GRE=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_NAT_MASQUERADE=y

# IP defragmentation (required for connection tracking)
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y

# IPv4 Netfilter/iptables
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# IPv6 Netfilter
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_MATCH_IPV6HEADER=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y

# nftables Support
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_CT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_MASQ_IPV4=y
CONFIG_NFT_MASQ_IPV6=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_META=y
CONFIG_NFT_HASH=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y

# Connection Tracking
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y

# ==== Block Devices ====
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y           # Loop devices for containers
CONFIG_BLK_DEV_DM=y             # Device mapper
CONFIG_DM_CRYPT=y               # Encryption support

# ==== Partition Table Support ====
CONFIG_PARTITION_ADVANCED=y     # Advanced partition selection
CONFIG_EFI_PARTITION=y          # EFI GUID Partition support (GPT)

# ==== NVMe Support ====
CONFIG_BLK_DEV_NVME=y           # NVMe block device driver
CONFIG_NVME_CORE=y              # NVMe core support
CONFIG_NVME_MULTIPATH=y         # NVMe multipath support
CONFIG_NVME_VERBOSE_ERRORS=y    # Verbose error reporting

# ==== Security ====
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ==== Console & TTY ====
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y

# ==== Init System ====
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ==== EFI/UKI Support ====
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_EFI_VARS=y

# ==== Device Drivers (MINIMAL) ====
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ==== Disable unnecessary subsystems ====
CONFIG_USB=n
CONFIG_SOUND=n
CONFIG_VIDEO=n
CONFIG_DRM=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_EVDEV=n
CONFIG_ACPI_BUTTON=n
CONFIG_WATCHDOG=n
CONFIG_HID=n

# ==== Performance & Debugging ====
CONFIG_NO_HZ_FULL=y             # Full tickless kernel
CONFIG_PREEMPT_RT=n             # Not needed for hypervisor
CONFIG_DEBUG_INFO=n             # Reduces size

# ==== Modules (optional, disable for smaller kernel) ====
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
